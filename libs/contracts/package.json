{
  "name": "@org/contracts",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "scope:shared"
    ],
    "targets": {
      "build": {
        "command": "tsc -b tsconfig.lib.json",
        "options": {
          "cwd": "libs/contracts"
        },
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {}
}
