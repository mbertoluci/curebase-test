{
  "name": "@org/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/web/src",
    "tags": [
      "scope:app"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ],
        "command": "tsc --project tsconfig.spec.json --noEmit",
        "options": {
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "@org/contracts": "*",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
