{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "rootDir": ".",
    "tsBuildInfoFile": "./out-tsc/jest/tsconfig.spec.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "index.d.ts",
    "next-env.d.ts",
    "jest.config.cts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    ".next"
  ],
  "references": [
    {
      "path": "../../libs/contracts"
    }
  ]
}
