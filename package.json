{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma",
    "dev": "nx run-many -t serve dev -p @org/api @org/web",
    "dev:api": "nx serve @org/api",
    "dev:web": "nx dev @org/web",
    "build": "nx run-many -t build -p @org/api @org/web",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "verify": "nx run-many -t typecheck lint test",
    "e2e": "nx e2e @org/api-e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,json,css,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/jest": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/nest": "^24.0.0",
    "@nx/next": "^24.0.0",
    "@nx/node": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/webpack": "24.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "lint-staged": "^16.4.0",
    "nx": "24.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.1",
    "next": "~16.1.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
