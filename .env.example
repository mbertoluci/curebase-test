# Copy to .env for local development: `cp .env.example .env`

# --- Database (matches docker-compose.yml; host port 5433 avoids clashing with a local Postgres) ---
DATABASE_URL="postgresql://bmi:bmi@localhost:5433/bmi?schema=public"

# --- API (NestJS) ---
# API_PORT (not PORT) so it doesn't collide with the Next dev server's PORT.
API_PORT=3333
API_GLOBAL_PREFIX=api
# Comma-separated list of origins allowed by CORS (the web app).
WEB_ORIGIN=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Web (Next.js) ---
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3333/api
